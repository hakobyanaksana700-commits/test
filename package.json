{
  "name": "getcard-reels",
  "version": "1.0.0",
  "private": true,
  "description": "GetCard — premium fintech Instagram Reels video built entirely with Remotion (SVG/CSS/React), no external assets.",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render src/index.ts GetCardReels out/GetCardReels.mp4",
    "still": "remotion still",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc -noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.516",
    "@remotion/cli": "4.0.516"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "typescript": "5.8.3"
  }
}
